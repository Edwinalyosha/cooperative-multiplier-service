generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DirectorMultiplier {
  id                                 Int      @id @default(autoincrement())
  clientId                           Int      @unique
  currentMultiplier                  Decimal  @db.Decimal(10,3)
  loanMultiple                       Decimal  @db.Decimal(10,3)

  contributionScore                  Int?
  repaymentScore                     Int?

  consecutiveOnTimeContributions     Int? @default(0)
  consecutiveOnTimeRepayments        Int? @default(0)

  lastContributionStatus             String?
  lastRepaymentStatus                String?

  /// Ownership stake, built from the weekly obligation. Earns the multiplier
  /// and is leveraged 1-5x into maxLoanAmount. Basis for any later profit
  /// split.
  contributionBalance                Decimal?  @db.Decimal(14, 2)
  /// Voluntary, liquid savings. Adds to maxLoanAmount at face value
  /// (savingsFactor) and confers no ownership — a member with none is not
  /// disadvantaged. Separated from contributions 2026-08-29; null means it
  /// has never been read from Fineract.
  savingsBalance                     Decimal?  @db.Decimal(14, 2)
  maxLoanAmount                      Decimal?  @db.Decimal(14, 2)
  isEligible                         Boolean?  @default(false)
  eligibilityCheckedAt               DateTime?

  createdAt                          DateTime @default(now())
  updatedAt                          DateTime @updatedAt

  history                            MultiplierHistory[]
}

/// One week's contribution obligation for one member.
///
/// The cooperative's model: every week a director owes a set amount. Miss it
/// and the obligation is DEFERRED, not forgiven — it stays owed, interest
/// free, until paid. A payment covers the current week first, then backfills
/// the oldest unpaid week.
///
/// Why a table rather than deriving this from transactions each time:
///
///  - **"Penalised once" becomes a fact, not a hope.** The penalty fires only
///    where penaltyAppliedAt IS NULL and stamps it in the same write. A
///    re-run, a restart, a late sweep or a manual contribution record are all
///    harmless. The previous design asked "has any multiplier event been
///    recorded since this period closed?", which is a proxy for the real
///    question and fails the moment anything else writes an event — the same
///    mistake that made StreakScheduler compound (see MLTD-P008).
///
///  - **amountDue is SNAPSHOTTED.** The weekly amount changes from time to
///    time; without storing it, raising 20,000 to 25,000 would retroactively
///    make everyone delinquent for weeks they had paid in full.
model ContributionPeriod {
  id                     Int      @id @default(autoincrement())
  clientId               Int

  /// Monday and Sunday of the week, in Africa/Kampala. Stored as dates
  /// because Fineract records transaction dates without a time component.
  periodStart            DateTime @db.Date
  periodEnd              DateTime @db.Date

  /// What was owed for THIS week, fixed when the period was created.
  amountDue              Decimal  @db.Decimal(14, 2)
  /// Allocated from the member's contribution-account deposits. A partial
  /// payment counts: the week is still late, but the money reduces the debt.
  amountPaid             Decimal  @db.Decimal(14, 2) @default(0)

  /// OPEN (not yet assessed) | SATISFIED | ARREARS
  status                 String   @default("OPEN")

  /// Set exactly once, the first time this week is found short. The unique
  /// constraint below plus this field are what guarantee one penalty per
  /// missed week.
  penaltyAppliedAt       DateTime?
  /// The step actually charged, stored so a waiver can reverse EXACTLY that
  /// rather than assuming today's configured value. It may differ: the step
  /// is configurable, and under shadow mode it is 0.
  penaltyStep            Decimal?  @db.Decimal(10, 3)
  /// A penalty forgiven by the finance manager. The multiplier movement is
  /// reversed and a PENALTY_WAIVED entry appears in the member's history, so
  /// "who forgave what, and why" is always answerable.
  waivedAt               DateTime?
  waivedBy               Int?
  waiveReason            String?
  /// Set exactly once, when a week that WAS in arrears is fully paid.
  arrearsRewardAppliedAt DateTime?
  satisfiedAt            DateTime?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([clientId, periodStart])
  /// The arrears query: what does this member still owe, oldest first.
  @@index([clientId, status])
}

/// One loan installment, and whether it was met on time.
///
/// The same shape as ContributionPeriod, for the same reason: "assess each
/// obligation exactly once" has to be a property of the data, not of how
/// often a scheduler happens to run. The unique constraint plus assessedAt
/// make a re-run, a restart or an overlapping cron harmless.
///
/// Timeliness is READ from Fineract's schedule, never inferred from payment
/// size. A 12,000 payment three weeks late would pass any amount threshold
/// while plainly being late, and no threshold can notice an installment that
/// was missed entirely.
model RepaymentAssessment {
  id                Int      @id @default(autoincrement())
  clientId          Int
  fineractLoanId    Int
  installmentNumber Int

  dueDate           DateTime @db.Date
  /// When the installment was fully paid. Null means it was overdue and
  /// unpaid at the moment it was assessed.
  metOn             DateTime? @db.Date
  /// ON_TIME | LATE
  outcome           String
  /// The step actually applied, so a waiver reverses exactly that — it may
  /// differ from today's configured value, and is 0 under shadow mode.
  stepApplied       Decimal? @db.Decimal(10, 3)

  /// Set once when a LATE installment is later paid off, so the catch-up
  /// reward is awarded exactly once.
  clearedAt         DateTime?

  /// A penalty forgiven by the finance manager.
  waivedAt          DateTime?
  waivedBy          Int?
  waiveReason       String?

  assessedAt        DateTime @default(now())

  @@unique([fineractLoanId, installmentNumber])
  @@index([clientId])
}

model MultiplierHistory {
  id              Int      @id @default(autoincrement())

  clientId        Int

  eventType       String
  oldMultiplier   Decimal? @db.Decimal(10,3)
  newMultiplier   Decimal? @db.Decimal(10,3)
  stepAmount      Decimal? @db.Decimal(10,3)

  direction       String?
  triggeredBy     String?
  notes           String?

  createdAt       DateTime @default(now())

  director        DirectorMultiplier @relation(fields: [clientId], references: [clientId])
}

/// Login identity for the loan-approval workflow. Deliberately separate from
/// Fineract's own "Admin User" concept — this grants only what the approval
/// flow needs (see context/loan-approval-workflow-spec.md), not back-office
/// access to Fineract itself.
model User {
  id           Int      @id @default(autoincrement())
  /// Links to DirectorMultiplier.clientId when this user is also a director.
  /// Nullable so a future non-director finance manager can exist.
  clientId     Int?     @unique
  username     String   @unique
  passwordHash String
  role         UserRole

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum UserRole {
  DIRECTOR
  FINANCE_MANAGER
  ADMIN
}

/// A member's loan request moving through the two-stage approval workflow.
/// Fineract stays authoritative for the actual money movement — fineractLoanId
/// points at the real loan record there; this table is the decision/audit
/// layer in front of it. See context/loan-approval-workflow-spec.md.
model LoanApplication {
  id                        Int       @id @default(autoincrement())
  clientId                  Int
  requestedAmount           Decimal   @db.Decimal(14, 2)
  /// Snapshot of eligibility at request time — never recalculated later.
  eligibilityAtRequestTime  Decimal   @db.Decimal(14, 2)
  status                    LoanApplicationStatus @default(PENDING_DIRECTOR_APPROVAL)
  requestedAt               DateTime  @default(now())

  financeDecidedBy          Int?
  financeDecidedAt          DateTime?
  financeNotes              String?

  /// Set at creation time (Fineract "Submitted and pending approval" state) —
  /// not at final approval. See spec doc for why the sequencing matters.
  fineractLoanId             Int?

  /// Set once Fineract has ACCEPTED the approve transition, before disburse
  /// is attempted. Finance approval is two separate Fineract calls, and the
  /// gap between them was unrecoverable: if approve succeeded and disburse
  /// failed, Fineract held the loan APPROVED while this row still said
  /// PENDING_FINANCE_APPROVAL, and every retry then failed because Fineract
  /// will not approve an already-approved loan. This makes the retry
  /// resumable — see LoansService.financeDecision.
  fineractApprovedAt         DateTime?

  /// Collateral hold placed on the borrower's SAVINGS account at
  /// disbursement, for the portion of the limit that came from savings rather
  /// than contributions. Without it, a member could save, borrow against the
  /// raised limit, and withdraw the backing — which is what makes a
  /// savingsFactor above 1.0 safe.
  ///
  /// The transaction id is Fineract's handle for the hold and the only way to
  /// release it, so it is stored rather than recomputed.
  savingsHoldAccountId       Int?
  savingsHoldTransactionId   Int?
  savingsHeldAmount          Decimal?  @db.Decimal(14, 2)
  savingsHoldReleasedAt      DateTime?

  approvals                  LoanApproval[]
}

enum LoanApplicationStatus {
  PENDING_DIRECTOR_APPROVAL
  PENDING_FINANCE_APPROVAL
  /// Fineract accepted the approval but disbursement did not complete. A
  /// real, recoverable state rather than an error: the money has not moved,
  /// the finance manager can retry, and the application is visible as stuck
  /// instead of silently sitting in PENDING_FINANCE_APPROVAL while Fineract
  /// disagrees.
  APPROVED_PENDING_DISBURSEMENT
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED
}

/// One row per director vote on a LoanApplication. The first APPROVE becomes
/// the loan's guarantor (isGuarantor = true) — real financial liability held
/// against their Fineract savings, not duplicated here. The second APPROVE
/// carries no such liability. See spec doc for the app-side consent
/// requirement this implies.
model LoanApproval {
  id                Int       @id @default(autoincrement())
  loanApplicationId Int
  directorClientId  Int
  decision          ApprovalDecision
  isGuarantor       Boolean   @default(false)
  notes             String?
  decidedAt         DateTime  @default(now())

  loanApplication   LoanApplication @relation(fields: [loanApplicationId], references: [id])

  @@unique([loanApplicationId, directorClientId])
}

enum ApprovalDecision {
  APPROVE
  REJECT
}

/// Captures a Fineract "User created" hook delivery (routed through n8n,
/// see director-webapp/ONBOARDING-AND-AUTH-PLAN.md) before we're able to
/// resolve it to a Client + mapping row. rawPayload is kept verbatim
/// because the exact Fineract hook payload shape was still unconfirmed
/// as of 2026-08-19 — this endpoint's first job is discovery, not
/// automatic User-row creation. Once the payload shape (and how to derive
/// clientId from it) is confirmed, resolving a row here should create the
/// matching `User` row and set resolvedClientId/resolvedAt/status.
model PendingOnboarding {
  id               Int      @id @default(autoincrement())
  fineractUsername String?
  email            String?
  firstname        String?
  lastname         String?
  fineractRole     String?
  rawPayload       Json
  status           OnboardingStatus @default(PENDING)
  createdAt        DateTime @default(now())
  resolvedAt       DateTime?
  resolvedClientId Int?

  /// Fineract Client id suggested by an exact-email match against Fineract
  /// (see FineractService.searchClientsByEmail) — a SUGGESTION only, never
  /// auto-applied. A human must click the emailed confirm link, which is
  /// what actually creates the User mapping row and sets resolvedClientId.
  suggestedClientId Int?
  /// Random opaque token (32-byte hex) for the one-click email confirm
  /// flow. Single-use: cleared (set null) once consumed, alongside status
  /// flipping to RESOLVED, so a reused/replayed link can't act twice.
  confirmToken      String?   @unique
  tokenExpiresAt    DateTime?
}

enum OnboardingStatus {
  PENDING
  RESOLVED
  IGNORED
}
